generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Leads (contact form submissions) ───────────────────────────────────────

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String     @db.Text
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([email])
  @@index([createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

// ─── Audit Requests (free growth audit) ────────────────────────────────────

model AuditRequest {
  id        String        @id @default(cuid())
  email     String
  name      String?
  company   String?
  status    AuditStatus   @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([email])
  @@index([createdAt])
}

enum AuditStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ─── Newsletter Subscribers ──────────────────────────────────────────────────

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Users (admin / staff) ───────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  role      Role      @default(STAFF)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]

  @@index([email])
}

enum Role {
  ADMIN
  STAFF
}

// ─── Sessions ────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}
